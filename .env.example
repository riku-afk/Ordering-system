# Copy this file to .env and adjust values for your local environment.
# docker-compose reads this automatically; the backend reads the same
# variable names via environment variables (see Backend/src/main/resources/application.yml).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ordering_system
DB_USERNAME=ordering_user
DB_PASSWORD=ordering_password

SERVER_PORT=8080

# Must be a Base64/plain secret at least 256 bits (32 chars) long.
JWT_SECRET=change-this-secret-in-your-env-it-must-be-at-least-256-bits-long
JWT_EXPIRATION_MS=86400000
